{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/build.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
