{
  "name": "zotero-ai-research-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "npm run build && node --test",
    "package": "node scripts/package/build-xpi.mjs",
    "verify:package": "node scripts/verify/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run package && npm run verify:package"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "markdown-it": "15.0.3"
  }
}
